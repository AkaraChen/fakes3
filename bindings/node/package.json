{
  "name": "fakes3-sdk",
  "version": "0.1.2",
  "description": "An in-memory S3 server for tests, running inside your Node.js process",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkaraChen/fakes3.git",
    "directory": "bindings/node"
  },
  "keywords": [
    "s3",
    "fake",
    "mock",
    "test",
    "in-memory"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "fakes3",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "test": "node --test __test__/s3.test.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@napi-rs/cli": "^3.10.9"
  }
}
